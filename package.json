{
  "name": "setengine",
  "productName": "SetEngine",
  "version": "1.0.0",
  "description": "A desktop toolkit for DJs: download tracks, extract set tracklists, analyze BPM and key, and build setlists",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "install-app": "bash scripts/package-app.sh",
    "fetch-tools": "node scripts/fetch-tools.mjs",
    "dist:mac": "node scripts/fetch-tools.mjs && electron-forge package --platform=darwin --arch=universal && node scripts/make-dmg.mjs",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [
    "youtube-music",
    "downloader",
    "mp3",
    "dj",
    "yt-dlp",
    "electron",
    "spotify",
    "bpm",
    "key-detection"
  ],
  "author": {
    "name": "theodoreiulian",
    "email": "theodore.iulian@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theodoreiulian/set-engine"
  },
  "bugs": {
    "url": "https://github.com/theodoreiulian/set-engine/issues"
  },
  "homepage": "https://github.com/theodoreiulian/set-engine#readme",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^42.5.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "node-id3": "^0.2.9",
    "p-limit": "^7.3.0",
    "shazamio-core": "^1.3.1"
  }
}
